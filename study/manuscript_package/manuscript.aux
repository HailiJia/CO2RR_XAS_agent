\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Reference spectra and layer-resolved response. (a) All available calculations and experimental references use the same 0--1 min--max rule on 8980--9020\nobreakspace  {}eV (201 points). These exact arrays produce Table\nobreakspace  {}\ref  {tab:similarity}; there is no separate display rescaling. One Cu-fitted energy offset per declared method is transferred to both oxides. Native processing is retained; the primary adds no unverified universal lifetime broadening or local pre-edge subtraction. Black is Experiment; colors identify the five methods. The dashed CuO FDMNES fdm line has a separate visible key: it is the supplied single-site curve with incomplete native final-state processing. Missing series are blank in the SI grids. (b) Layer-averaged spectra of one CO-containing interface; surface denotes the outermost Cu layer. The earlier species-present/absent panel is omitted because an adsorbate-containing mean is not a clean-parent control.\relax }}{8}{figure.caption.3}\protected@file@percent }
\newlabel{fig:spectroscopy}{{3}{8}{Reference spectra and layer-resolved response. (a) All available calculations and experimental references use the same 0--1 min--max rule on 8980--9020~eV (201 points). These exact arrays produce Table~\ref {tab:similarity}; there is no separate display rescaling. One Cu-fitted energy offset per declared method is transferred to both oxides. Native processing is retained; the primary adds no unverified universal lifetime broadening or local pre-edge subtraction. Black is Experiment; colors identify the five methods. The dashed CuO FDMNES fdm line has a separate visible key: it is the supplied single-site curve with incomplete native final-state processing. Missing series are blank in the SI grids. (b) Layer-averaged spectra of one CO-containing interface; surface denotes the outermost Cu layer. The earlier species-present/absent panel is omitted because an adsorbate-containing mean is not a clean-parent control.\relax }{figure.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Reference-v2 similarities on the exact Figure\nobreakspace  {}3a arrays. Cu calibration is transferred to the oxides; missing series are omitted.\relax }}{9}{table.caption.4}\protected@file@percent }
\newlabel{tab:similarity}{{1}{9}{Reference-v2 similarities on the exact Figure~3a arrays. Cu calibration is transferred to the oxides; missing series are omitted.\relax }{table.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Automated adsorbate identification}{9}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Automated inference from simulated Cu K-edge spectra. (a) Pooled held-out micro and macro F1 for the primary and fixed-depth selectors. (b) Species-level F1; numbers give positive configuration counts, with asterisks for fewer than five positives. (c) Separate plots compare individual layers (left; layer 1 is the surface) and population-weighted means of the top $n$ layers (right). Thus $n=2$ combines the surface and its immediate subsurface layer. Error bars are conditional 95\% intervals from 1500 held-out bootstrap resamples. (d) Exploratory feature/model comparison for the surface layer. Normalized energy spectrum denotes normalized intensity on the energy grid; CDF, cumulative integral; d1, first derivative; Combined, concatenated spectrum/integral/derivative features; and DCT24, the first 24 cosine coefficients. Green indicates higher F1 and gray lower F1. Thresholds use training data; the highest observed fixed entry is exploratory.\relax }}{10}{figure.caption.5}\protected@file@percent }
\newlabel{fig:ml}{{4}{10}{Automated inference from simulated Cu K-edge spectra. (a) Pooled held-out micro and macro F1 for the primary and fixed-depth selectors. (b) Species-level F1; numbers give positive configuration counts, with asterisks for fewer than five positives. (c) Separate plots compare individual layers (left; layer 1 is the surface) and population-weighted means of the top $n$ layers (right). Thus $n=2$ combines the surface and its immediate subsurface layer. Error bars are conditional 95\% intervals from 1500 held-out bootstrap resamples. (d) Exploratory feature/model comparison for the surface layer. Normalized energy spectrum denotes normalized intensity on the energy grid; CDF, cumulative integral; d1, first derivative; Combined, concatenated spectrum/integral/derivative features; and DCT24, the first 24 cosine coefficients. Green indicates higher F1 and gray lower F1. Thresholds use training data; the highest observed fixed entry is exploratory.\relax }{figure.caption.5}{}}
